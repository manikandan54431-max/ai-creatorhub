# Default local DB (SQLite). Leave as-is for local dev.
DATABASE_URL=sqlite:///./creatorhub.db

# ── Aiven for MySQL (production) ─────────────────────────────────────────────
# When MYSQL_HOST is set, the backend connects to MySQL over verified TLS and
# ignores DATABASE_URL. Fill these from the Aiven Console service "Overview"
# page. The username is NOT the database name (Aiven's default DB is defaultdb).
# Do NOT commit real values — these are placeholders only.
MYSQL_HOST=your-service.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=__set_in_secure_backend_env__
MYSQL_DATABASE=defaultdb
# Path to the Aiven CA certificate (download "ca.pem" from the service Overview
# page). TLS verification is always on; do not disable it.
MYSQL_SSL_CA=./certs/aiven-ca.pem
# Hosts where you can't commit a cert file (e.g. Render): instead of MYSQL_SSL_CA,
# paste the full PEM text of ca.pem into this env var. The app writes it to a
# temp file at startup and uses that. If set, it takes precedence over MYSQL_SSL_CA.
# MYSQL_SSL_CA_CONTENT="-----BEGIN CERTIFICATE-----\n...full cert...\n-----END CERTIFICATE-----"

SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ADMIN_EMAIL=admin@aicreatorhub.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Platform Admin

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PLATFORM_COMMISSION_PERCENT=20
FRONTEND_URL=http://localhost:5173

STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# PixVerse AI video generation (creator-only). Leave PIXVERSE_API_KEY blank to
# disable the feature (the page then shows an honest "unavailable" state).
# The key must be a DIRECT PixVerse developer API key, not a reseller/Growth key.
PIXVERSE_API_KEY=
PIXVERSE_MODEL=v5
PIXVERSE_DEFAULT_QUALITY=540p
PIXVERSE_DEFAULT_DURATION=5
